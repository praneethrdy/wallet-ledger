# Copy to .env to override (never commit .env). docker compose reads it automatically.
# These dev values match the defaults in docker-compose.yml and application-dev.yml.
# Production must supply its own values via a secrets manager — see docs/deployment.md.
# Host port for the dev database. 5433, not 5432, so it can't collide with a locally installed Postgres.
POSTGRES_PORT=5433
POSTGRES_DB=wallet

# Superuser: used only by the postgres container itself (and tests that must bypass triggers).
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_dev

# Schema owner: Flyway connects as this role to run migrations (DDL).
DB_OWNER_USER=wallet_owner
DB_OWNER_PASSWORD=owner_dev

# Application role: the running app connects as this role (DML only, least privilege).
DB_APP_USER=wallet_app
DB_APP_PASSWORD=app_dev
