meta {
  name: Login as support
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{supportEmail}}",
    "password": "{{supportPassword}}"
  }
}

script:post-response {
  bru.setVar("supportToken", res.body.accessToken);
}
