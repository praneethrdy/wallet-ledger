# Copy to .env.local for development. Never commit real values.

# Where the Spring backend listens. Server-side only: the browser never talks to it.
API_BASE_URL=http://localhost:8080

# Encrypts the session cookie (iron-session). At least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

# Dev only: shows the mock payment page and the one-click demo accounts on /login.
# Must be unset (or false) in production.
MOCK_PROVIDER_ENABLED=true
