# Copy to .env.local for development. Never commit real values.

# Where the Spring backend listens. Server-side only: the browser never talks to it.
API_BASE_URL=http://localhost:8080

# Encrypts the session cookie (iron-session). At least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

# Dev only: lists the seeded demo accounts on /login (and enables demo payments).
# Must be unset (or false) in production.
MOCK_PROVIDER_ENABLED=true

# Public demo: "Add money" completes with a labelled, simulated payment.
# The backend's DEMO_PAYMENTS_ENABLED must be true as well.
# DEMO_PAYMENTS_ENABLED=true

# Production only (optional): a public demo customer listed on /login. Must match the backend's
# BOOTSTRAP_DEMO_EMAIL / BOOTSTRAP_DEMO_PASSWORD. Never put a staff login here.
# DEMO_LOGIN_EMAIL=demo@yourdomain.example
# DEMO_LOGIN_PASSWORD=
